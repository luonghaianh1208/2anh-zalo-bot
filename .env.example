# ============================================================
#  2Anh Zalo Bot — biến môi trường
#  Chép file này thành .env rồi điền. KHÔNG commit file .env.
# ============================================================

# --- Cầu nối sang Hermes ------------------------------------
# Cổng WebSocket mà Hermes Agent cắm vào. Chỉ đổi khi bị trùng cổng.
# ZALO_BRIDGE_PORT=3873

# Cổng dashboard quản trị (giao diện quét QR).
# ZCA_PORT=3872


# ============================================================
#  Các biến dưới đây đặt ở .env của HERMES, không phải file này
#  (thường là %LOCALAPPDATA%\hermes\.env trên Windows,
#   hoặc ~/.hermes/.env trên Linux/macOS)
# ============================================================
#
# ZALO_BRIDGE_URL=ws://127.0.0.1:3873
#
# UID Zalo được phép sai bảo bot. Là dãy số DÀI (17-21 chữ số),
# KHÔNG phải số điện thoại. Lấy UID bằng cách nhắn /sethome cho bot.
# ZALO_ALLOWED_USERS=
#
# Cho phép mọi người dùng bot — chỉ dùng khi thử nghiệm.
# ZALO_ALLOW_ALL_USERS=false
#
# Trong nhóm chỉ trả lời khi được tag (khuyến nghị giữ true).
# ZALO_GROUP_REPLY_ONLY_TAGGED=true
#
# Nơi nhận kết quả các tác vụ hẹn giờ (cron) của Hermes.
# ZALO_HOME_CHANNEL=
# ZALO_HOME_CHANNEL_NAME=


# ============================================================
#  Chỉ cần khi chạy KHÔNG kèm Hermes (chế độ chatbot độc lập)
# ============================================================
# Bình thường bot tự đọc khoá và model từ cấu hình Hermes.
# Đặt ở đây nếu muốn ghi đè hoặc chạy riêng.
#
# CUSTOM_API_KEY=
# CUSTOM_BASE_URL=http://127.0.0.1:20128/v1
# HERMES_MODEL=hermes
#
# Trỏ tới thư mục cài Hermes nếu nó nằm ngoài vị trí mặc định.
# HERMES_HOME=

# ============================================================
#  Ai được dùng bot (đặt ở .env của HERMES)
# ============================================================
# Mở cổng cho cả nhóm, không phải khai từng UID. Rào chắn thật nằm ở
# tầng toolset: người ngoài chỉ nhận zalo_public (7 công cụ, không có
# terminal / read_file / browser). Cờ này KHÔNG phong ai làm chủ.
# ZALO_ALLOW_ALL_USERS=true
#
# Ai được nhắn riêng: owner-only (mặc định) hoặc open.
# ZALO_DM_POLICY=owner-only

# Kho tài liệu tư vấn: thư mục bot được phép ĐỌC khi cần tra cứu sản phẩm,
# dịch vụ. Chỉ đọc, chỉ trong thư mục này. Tự bỏ qua node_modules, thư mục
# ẩn, và tệp có tên gợi ý dữ liệu riêng tư (backup, order, customer…).
# Nên trỏ vào một thư mục tài liệu thuần, đừng trỏ vào cả thư mục dự án.
# ZALO_KB_DIR=

# Sổ hồ sơ người quen trên Zalo (tra theo UID). Mặc định:
# <hermes>/zalo/people.json
# ZALO_PEOPLE_FILE=

# ============================================================
#  Giãn nhịp gửi — chống bị Zalo coi là spam (đặt ở .env của SIDECAR)
# ============================================================
# Token bucket, áp cho mọi lệnh tạo ra nội dung người khác nhìn thấy
# (nhắn tin, sticker, tệp, chuyển tiếp, bình chọn, mời vào nhóm).
# KHÔNG áp cho gõ phím / đã xem / thả cảm xúc / đọc dữ liệu.
#
# Mặc định: bắn liền 5 tin không chờ, sau đó giãn về 20 tin/phút. Một
# câu trả lời chỉ bị tách khi dài hơn 4000 ký tự, nên hội thoại bình
# thường không bao giờ chạm hạn mức này.
# ZALO_RATE_BURST=5
# ZALO_RATE_INTERVAL_MS=3000
#
# Chờ lâu hơn mức này thì báo lỗi rõ ràng thay vì để adapter timeout
# (adapter chờ ack tối đa 30s). Đừng đặt ≥ 30000.
# ZALO_RATE_MAX_WAIT_MS=20000

# ============================================================
#  Chống nhắn dồn dập (đặt ở .env của HERMES)
# ============================================================
# Bot chỉ trả lời khi bị tag, nhưng mỗi lần tag là một lượt gọi mô hình
# tính phí. Quá ngưỡng thì báo đúng một câu rồi im trong thời gian nghỉ.
# Chủ nhân được miễn trừ.
#
# Ngưỡng để rộng tay có chủ đích — người hỏi bình thường không chạm tới.
# ZALO_FLOOD_THRESHOLD=6
# ZALO_FLOOD_WINDOW_S=15
# ZALO_FLOOD_MUTE_S=90
