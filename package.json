{
  "name": "2anh-zalo-bot",
  "version": "1.9.2",
  "description": "Cầu nối Zalo cho Hermes Agent — đăng nhập bằng QR, chạy như một nền tảng đầy đủ của Hermes (tools, memory, skills), kèm dashboard quản trị cục bộ.",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "npm run test:js && npm run test:py",
    "test:js": "node --test",
    "test:py": "node scripts/run-python-tests.js",
    "setup": "node scripts/setup.js",
    "install:hermes": "node scripts/install-hermes.js",
    "doctor": "node scripts/doctor.js",
    "uninstall:hermes": "node scripts/uninstall-hermes.js"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "zalo",
    "hermes-agent",
    "zca-js",
    "chatbot",
    "vietnamese"
  ],
  "author": "2Anh AI Education",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/luonghaianh1208/2anh-zalo-bot.git"
  },
  "dependencies": {
    "express": "^5.2.1",
    "ws": "^8.21.3",
    "yaml": "^2.9.0",
    "zca-js": "^2.1.2"
  }
}
